# Copy to .env and fill in. Never commit .env.
# Data directory for raw, points, sorties, baselines, alerts
TW_DATA_DIR=./data

# Live providers (M4)
ADSBLOL_BASE_URL=https://api.adsb.lol
AIRPLANESLIVE_BASE_URL=https://api.airplanes.live
ADSBFI_BASE_URL=https://opendata.adsb.fi/api

# Shared storage read by the Vercel dashboard (M5)
DATABASE_URL=
BLOB_READ_WRITE_TOKEN=

# X credentials: worker only, never on Vercel (M7)
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# Optional LLM rewording of template drafts (M7)
ANTHROPIC_API_KEY=
